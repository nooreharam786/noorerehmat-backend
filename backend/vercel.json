{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run prisma:deploy && npm run prisma:generate && npm run build",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
