generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum ApplicationStatus {
  pending
  selected
  not_selected
}

enum PaymentStatus {
  pending
  paid
  failed
}

model User {
  id                String               @id @default(cuid())
  name              String
  email             String               @unique
  password          String
  role              Role                 @default(user)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  application       Application?
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([createdAt])
}

model Application {
  id            String            @id @default(cuid())
  userId        String            @unique
  coverId       String            @unique
  phone         String
  stateCode     String
  stateName     String
  city          String
  persons       Int               @default(1)
  entryFee      Int               @default(1500)
  status        ApplicationStatus @default(pending)
  paymentStatus PaymentStatus     @default(pending)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  travellers     ApplicantPerson[]

  @@index([status])
  @@index([paymentStatus])
  @@index([stateCode])
  @@index([coverId])
  @@index([createdAt])
}

model ApplicantPerson {
  id            String      @id @default(cuid())
  applicationId String
  fullName      String
  phone         String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([phone])
}

model DrawResult {
  id            String   @id @default(cuid())
  totalUsers    Int
  selectedCount Int
  percentage    Float?
  createdAt     DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id          String   @id @default(cuid())
  filename    String
  contentType String
  data        Bytes
  size        Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model PublicDocument {
  id          String   @id @default(cuid())
  title       String
  description String?
  filename    String
  contentType String
  data        Bytes
  size        Int
  kind        String   @default("dua")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@index([createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  message   String
  location  String?
  source    String   @default("public")
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved])
  @@index([createdAt])
}
