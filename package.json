{
  "name": "sacred-journey-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:backend": "npm --workspace backend run dev",
    "dev:admin": "npm --prefix admin run dev",
    "build": "npm --workspace backend run build && npm --prefix admin run build",
    "postinstall": "npm --workspace backend run prisma:generate",
    "start": "npm --workspace backend start",
    "install:all": "npm --workspace backend install && npm --prefix admin install"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
